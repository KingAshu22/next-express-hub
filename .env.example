# Copy to .env (local) and set the same keys in your hosting dashboard.
# Never commit real values.

# MongoDB
MONGODB_URI=
MONGODB_DB=test

# Session token signing secrets: long random strings (64+ chars), different per environment.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_ACCESS_SECRET=
AUTH_REFRESH_SECRET=

# M5 tracking (server-only - do NOT use NEXT_PUBLIC_ names, those are sent to the browser)
M5_ACCOUNT_CODE=
M5_USERNAME=
M5_PASSWORD=
M5_ACCESS_KEY=

# Courier Journey
COURIER_JOURNEY_USER_ID=
COURIER_JOURNEY_PASSWORD=
COURIER_JOURNEY_CUSTOMER_CODE=

# DHL
DHL_API_KEY=
